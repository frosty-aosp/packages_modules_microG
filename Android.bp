package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex_key {
    name: "com.frosty.microg.key",
    public_key: "com.frosty.microg.avbpubkey",
    private_key: "com.frosty.microg.pem",
}

android_app_import {
    name: "GmsCoreMicrog",
    owner: "microg",
    apk: "GmsCore/GmsCore.apk",
    presigned: true,
    privileged: true,
    uses_libs: ["com.android.location.provider"],
    optional_uses_libs: [
        "org.apache.http.legacy",
        "androidx.window.extensions",
        "androidx.window.sidecar"
    ],
    required: [
        "microg.xml",
        "default-permissions-com.google.android.gms.xml",
        "privapp-permissions-com.google.android.gms.xml",
        "sysconfig-com.google.android.gms.xml",
    ],
    apex_available: [
        "//apex_available:platform",
        "com.frosty.microg",
    ],
}

android_app_import {
    name: "FakeStore",
    owner: "microg",
    apk: "FakeStore/FakeStore.apk",
    presigned: true,
    privileged: true,
    required: [
        "default-permissions-com.android.vending.xml",
        "privapp-permissions-com.android.vending.xml",
    ],
    apex_available: [
        "//apex_available:platform",
        "com.frosty.microg",
    ],
}

android_app_import {
    name: "GsfProxy",
    owner: "microg",
    apk: "GsfProxy/GsfProxy.apk",
    presigned: true,
    apex_available: [
        "//apex_available:platform",
        "com.frosty.microg",
    ],
}

apex {
    name: "com.frosty.microg",
    defaults: ["u-launched-apex-module"],
    manifest: "manifest.json",
    apps: ["GmsCoreMicrog", "FakeStore", "GsfProxy"],
    overrides: [ "com.frosty.microg-stub" ],
    prebuilts: [
        "microg.xml",
        "default-permissions-com.android.vending.xml",
        "privapp-permissions-com.android.vending.xml",
        "default-permissions-com.google.android.gms.xml",
        "privapp-permissions-com.google.android.gms.xml",
        "sysconfig-com.google.android.gms.xml"
    ],
    key: "com.frosty.microg.key",
    certificate: ":microg.certificate",
    compressible: false,
    updatable: true,
}

apex {
    name: "com.frosty.microg-stub",
    defaults: ["u-launched-apex-module"],
    manifest: "manifest-stub.json",
    key: "com.frosty.microg.key",
    certificate: ":microg.certificate",
    compressible: false,
    updatable: true,
}
